# Environment files (secrets)
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging

# Per-stack service env files and mounted service-account keys are rendered on the
# VPS at deploy time and must never be committed (belt-and-suspenders alongside the
# deploy rsync --exclude rules).
**/credentials/sa-key.json

# ...but everything under a stack's ci/ is a TEMPLATE carrying @@MARKER@@ placeholders,
# never a real value, and MUST be committed -- it is the input render-ci.py fills in at
# deploy time. Without these negations the templates are silently untracked and CI
# renders nothing. Keep them narrow: only ci/ is exempt.
!**/ci/.env.*
!**/ci/credentials/sa-key.json

# Claude Code local settings (contains tokens). Skills under .claude/skills/ are
# repo procedure and MUST be committed -- keep this narrow.
.claude/settings.local.json
.claude/*.local.json

# MCP config (contains tokens — use .mcp.json.example as template)
.mcp.json

# SSH keys
*.pem
*.key
id_rsa*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Grafana data (generated at runtime)
monitoring/grafana/data/

# Prometheus data (generated at runtime)
monitoring/prometheus/data/

# Loki data
monitoring/loki/data/

# Terraform (if added later)
*.tfstate
*.tfstate.backup
.terraform/

# Node
node_modules/
package-lock.json

# Python bytecode, created by running the repo's own scripts from a checkout
__pycache__/
*.pyc
