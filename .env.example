# Copy to .env — NEVER commit .env to git.
# Only what something actually reads. Audited 2026-08-27: the five VPS host IPs, the four
# `*_USER` lines and the four non-root `*_PASSWORD` lines were deleted — nothing read them,
# `~/.ssh/config` already carries the IPs as comments, and `PasswordAuthentication no` is set
# on all five hosts, so a password buys nothing over SSH.

# ─── Blueprint account (kaiteki.my / blueprintdigital.my / reservetoday.app) ──
# bpvps1 root creds. The ONLY break-glass credential we hold: with port 22 tailnet-only and
# password auth off, hPanel's browser console is the last way in, and it wants root.
# The other four hosts have no console credential here — that gap is known, not an oversight.
BPVPS1_HOST=
BPVPS1_USER=root
BPVPS1_PASSWORD=

# Hostinger API token — covers bpvps1 + bpvps2 only. Also paste into .mcp.json.
HOSTINGER_API_TOKEN=

# Cloudflare token for the Blueprint account. Despite the name it is NOT kaiteki-only —
# it covers all three Blueprint zones. Used by acme.sh on bpvps1 + bpvps2 (renew-cert.sh),
# so renaming it means editing on-host stack .env files. Left as-is deliberately.
KAITEKI_CF_DNS_API_TOKEN=

# ─── Account-agnostic ────────────────────────────────────────────────────────
# GitHub (PAT for curl/REST API — repo + org read/write)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Mailbox passwords for scripts/verify-mail.sh. One per account it should prove a login
# for, named MAIL_PASSWORD_<ACCOUNT> with the address uppercased and every non-alphanumeric
# character replaced by _ . These are ordinary mailbox credentials, not admin ones.
MAIL_PASSWORD_ADMIN_KAITEKI_MY=

# The bpvps1 Stalwart platform administrator (Admin role). scripts/mail-inventory.py needs
# this one to enumerate accounts; admin@kaiteki.my lost the role on 2026-09-12.
MAIL_PASSWORD_ADMIN_BLUEPRINTDIGITAL_MY=

# reservetoday.app's own admin mailbox (#10). An ordinary mailbox, not a platform admin --
# it is what verify-mail.sh reservetoday.app signs in as.
MAIL_PASSWORD_ADMIN_RESERVETODAY_APP=

# ─── Not here on purpose ─────────────────────────────────────────────────────
# N8N_API_KEY lives only in .mcp.json (n8n-teeko server). It is the one credential outside
# the "all credentials live in .env" rule; noted so nobody re-adds it here and forgets which
# copy is real.
