# Copy to .env — NEVER commit .env to git.
# Only what something actually reads. Audited 2026-08-27: the five VPS host IPs, the four
# `*_USER` lines and the four non-root `*_PASSWORD` lines were deleted — nothing read them,
# `~/.ssh/config` already carries the IPs as comments, and `PasswordAuthentication no` is set
# on all five hosts, so a password buys nothing over SSH.

# ─── Blueprint account (kaiteki.my / blueprintdigital.my / reservetoday.app) ──
# bpvps1 root creds. The ONLY break-glass credential we hold: with port 22 tailnet-only and
# password auth off, hPanel's browser console is the last way in, and it wants root.
# The other four hosts have no console credential here — that gap is known, not an oversight.
BPVPS1_HOST=
BPVPS1_USER=root
BPVPS1_PASSWORD=

# Hostinger API token — covers bpvps1 + bpvps2 only. Also paste into .mcp.json.
HOSTINGER_API_TOKEN=

# Cloudflare token for the Blueprint account. Despite the name it is NOT kaiteki-only —
# it covers all three Blueprint zones. Used by acme.sh on bpvps1 (renew-cert.sh) for the
# one mail certificate, so renaming it means editing that host's stack .env. Left as-is
# deliberately. The zone-scoped BPD_CF_DNS_API_TOKEN that bpvps2's mail stack used went
# with that stack on 2026-09-12 (#12) and was revoked on 2026-09-15 (#20).
KAITEKI_CF_DNS_API_TOKEN=

# ─── Account-agnostic ────────────────────────────────────────────────────────
# GitHub (PAT for curl/REST API — repo + org read/write)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Mailbox passwords for scripts/verify-mail.sh. One per account it should prove a login
# for, named MAIL_PASSWORD_<ACCOUNT> with the address uppercased and every non-alphanumeric
# character replaced by _ . These are ordinary mailbox credentials, not admin ones.
MAIL_PASSWORD_ADMIN_KAITEKI_MY=

# The bpvps1 Stalwart platform administrator (Admin role). scripts/mail-inventory.py needs
# this one to enumerate accounts; admin@kaiteki.my lost the role on 2026-09-12.
MAIL_PASSWORD_ADMIN_BLUEPRINTDIGITAL_MY=

# reservetoday.app's own admin mailbox (#10). An ordinary mailbox, not a platform admin --
# it is what verify-mail.sh reservetoday.app signs in as.
MAIL_PASSWORD_ADMIN_RESERVETODAY_APP=

# Grafana Cloud, for scripts/grafana-apply.py only (dashboards + alert rules from grafana/).
# A service-account token with the Editor role. The agents' own push credentials are NOT
# here — they are per-host GitHub Environment variables/secrets (GRAFANA_CLOUD_*). docs/monitoring.md.
# Likewise the Database Observability role's passwords, DB_O11Y_STAGING_PASSWORD and
# DB_O11Y_PROD_PASSWORD: secrets in the bpvps2 GitHub Environment only, never here (#166).
GRAFANA_URL=
GRAFANA_SA_TOKEN=
# Synthetic Monitoring (external endpoint checks, #24). Take the API address —
# https://synthetic-monitoring-api-<region>.grafana.net — NOT the gRPC "backend address" the
# Config page shows first (…-grpc-…:443), which is for private probes to dial in on.
GRAFANA_SM_URL=
GRAFANA_SM_TOKEN=
# Where alerts are delivered. Substituted into grafana/alerting/notifications.yml at apply
# time; unset fails the run. It is a credential — anyone holding it can post to the channel —
# and this repo is public, so it lives here and never in the yaml.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# ─── Not here on purpose ─────────────────────────────────────────────────────
# N8N_API_KEY lives only in .mcp.json (n8n-teeko server). It is the one credential outside
# the "all credentials live in .env" rule; noted so nobody re-adds it here and forgets which
# copy is real.
#
# Bulwark branding (APP_NAME, LOGIN_*, DOMAIN_BRANDING, …) is NOT a secret and is NOT here.
# It is written as literal values in vps/bpvps1/stacks/stalwart/docker-compose.yml (#11) so
# the brand per webmail hostname is reviewable in a diff. The only Bulwark values that are
# secrets — BULWARK_SESSION_SECRET (never rotate it) and BULWARK_ADMIN_PASSWORD — live in
# that stack's on-host .env, and STALWART_RECOVERY_PASS beside them.
