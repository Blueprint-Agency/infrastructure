// Grafana Alloy -- Grafana Database Observability for the two booking Postgres instances
// (booking-system#166). Query statistics, query samples and schema details to Grafana Cloud.
// Runbook: docs/monitoring.md, "Database Observability".
//
// Why a second agent, and not a few blocks in the monitoring stack's config.alloy:
//   - That agent runs on the HOST network, and neither booking Postgres publishes a port.
//     This one sits on both booking networks and reaches each database by container name.
//   - That config is one implementation copied to every monitored host (CI fails on drift),
//     and only bpvps2 has a booking database.
//
// What leaves the host is bounded twice: the collectors below, and the keep-list in
// prometheus.relabel "keep" at the bottom. The free tier is 10,000 active series for the
// whole account; this stack's share is about 1,100 (docs/monitoring.md, "Budget").
//
// Credentials: the monitoring role `db-o11y` (setup-db-o11y.sql, next to this file) with its
// own password per instance, and the same Grafana Cloud token as the monitoring stack. All
// from the environment, which CI renders from the bpvps2 GitHub Environment (ci/env.ci).
// Grafana's own example reads the DSN from a `local.file { is_secret = true }` instead; this
// stack uses sys.env deliberately, to keep the one CI rendering path the monitoring stack
// already uses (a root-owned .env either way), and it loses no redaction -- data_source_name
// is typed `secret`, so Alloy still prints `(secret)` in the debug UI.

logging {
  level = "warn"
}

// One booking Postgres: the exporter for pg_stat_statements metrics, the Database
// Observability collectors, and the labels Database Observability groups by.
declare "booking_postgres" {
  // booking-staging | booking-prod -- the stack directory, as `compose_project` is everywhere
  // else. Becomes the `instance` label, which is what Database Observability lists.
  argument "instance" {}

  // The container name, which resolves on that instance's booking network.
  argument "db_host" {}

  argument "password" {}
  argument "metrics_receiver" {}
  argument "logs_receiver" {}

  // Database `postgres`, as Grafana recommends: autodiscovery below finds the booking
  // database on its own, so its name (a secret in booking-system's deploy) never appears here.
  // sslmode=disable departs from Grafana's `require` examples because postgres:16-alpine
  // ships no server certificate -- `require` would simply fail until TLS is configured on
  // each Postgres. The connection never leaves the booking network on this host.
  // The password is generated hex (docs/monitoring.md), so it needs no URL escaping.
  prometheus.exporter.postgres "db" {
    data_source_names = [string.format("postgres://db-o11y:%s@%s:5432/postgres?sslmode=disable", argument.password.value, argument.db_host.value)]

    // pg_settings is ~300 series per instance and nothing reads it.
    disable_settings_metrics = true
    enabled_collectors       = ["stat_statements", "database", "stat_database"]

    stat_statements {
      exclude_users = ["db-o11y"]
      // The statements with the most total time. Each one is ~5 series; see "Budget".
      limit = 100
    }

    autodiscovery {
      enabled = true
    }
  }

  database_observability.postgres "db" {
    data_source_name = string.format("postgres://db-o11y:%s@%s:5432/postgres?sslmode=disable", argument.password.value, argument.db_host.value)
    targets          = prometheus.exporter.postgres.db.targets
    forward_to       = [loki.process.trim.receiver]

    // explain_plans OFF: EXPLAIN needs SELECT on the tables it plans. Grafana's alternative,
    // pg_read_all_data, does NOT set BYPASSRLS, and booking-system's migration 0033 FORCEs
    // row-level security on every table carrying tenant_id -- so the grant would read those
    // back EMPTY, not read members and payments. What it would expose is what 0033 leaves
    // outside RLS: the `tenants` / `tenant_settings` rows, each Tenant's identity, premises
    // and branding copy, plus any table with no tenant_id column. Reason enough to refuse.
    //
    // query_details, query_samples and schema_details need only pg_monitor and the system
    // catalogs -- validated against Alloy v1.19.2, whose schema_details reads pg_catalog
    // only (never information_schema, which would show this role nothing). Grafana's setup
    // page asks for object privileges; skipping that step is coupled to this version, so
    // re-read that collector before the Dockerfile's tag moves. Do not "fix" an empty
    // schema tab with pg_read_all_data.
    //
    // query_samples OFF since 2026-10-09, when the logs allowance ran out. It was blamed for
    // the `op="query_association"` stream and is NOT its source -- query_details is (see
    // below), so turning this off changed nothing and the allowance was at 80% again by
    // Nov 11. It stays off anyway: it is Loki lines at a 10 s default interval and has never
    // been measured here. If it comes back, it comes back with a measured daily volume in
    // docs/monitoring.md "Budget" and a raised `collect_interval`.
    // (It REDACTS literals by default -- disable_query_redaction = false -- keep it so.)
    disable_collectors = ["explain_plans", "query_samples"]

    // query_details is where the logs allowance went (#54). Every interval it sends the full
    // text of the top 100 statements by total time as `op="query_association"`, with no
    // dedup and no truncation (Alloy v1.19.2, collector/query_details.go). Measured
    // 2026-11-11: 4.13 GB/day for the two instances against a 50 GB month, 97% of it ten
    // bulk INSERTs of ~150 KB each, re-sent every minute. `statements_limit` cannot help --
    // the offenders ARE the top statements. So: the same text every 5 minutes instead of
    // every minute here, and loki.process "trim" below cuts each one to 1000 characters.
    query_details {
      collect_interval = "5m"
    }

    // The schema changes on a deploy, not every minute. At the 1m default this was the
    // largest stream left after the trim (~39 MB/day for the two instances, measured
    // 2026-11-11). Cost: a Grafana time range under 10 minutes may show no schema.
    schema_details {
      collect_interval = "10m"
    }
  }

  // The byte budget for this stack's log lines. Order matters.
  loki.process "trim" {
    forward_to = [loki.relabel.db.receiver]

    // Cut querytext to 1000 characters and mark the cut with "..." (the collector's own
    // convention for truncated text). The pattern eats escape pairs whole, so the cut never
    // lands inside one. 1000 is RE2's repeat ceiling -- it cannot be raised. Proven on 200
    // real lines with this image: 3.2 MB in, 0.16 MB out, none lost.
    stage.replace {
      expression = `querytext="(?:[^"\\]|\\.){1000}((?:[^"\\]|\\.)+)" datname=`
      replace    = "..."
    }

    // The backstop. The pattern above depends on `querytext="..." datname=` in that order;
    // if an Alloy upgrade moves a field it stops matching and says nothing. A line still
    // this long after the trim is dropped rather than shipped.
    stage.drop {
      longer_than         = "8KB"
      drop_counter_reason = "oversize"
    }

    // And a ceiling on how many. One instance sends ~310 lines per query_details cycle and
    // ~100 per schema cycle (measured 2026-11-11), about 1.2 a second on average, so the
    // burst holds three whole cycles and the rate is over twice the average. Past that,
    // lines are dropped: a collector that starts sending ten times as much is a bug, and
    // the allowance is shared with every real log on both hosts.
    stage.limit {
      rate  = 3
      burst = 1000
      drop  = true
    }
  }

  loki.relabel "db" {
    forward_to = [argument.logs_receiver.value]

    rule {
      target_label = "instance"
      replacement  = argument.instance.value
    }

    rule {
      target_label = "host"
      replacement  = sys.env("MONITORING_HOST")
    }
  }

  discovery.relabel "db" {
    targets = database_observability.postgres.db.targets

    // The job name Database Observability looks for.
    rule {
      target_label = "job"
      replacement  = "integrations/db-o11y"
    }

    rule {
      target_label = "instance"
      replacement  = argument.instance.value
    }

    rule {
      target_label = "host"
      replacement  = sys.env("MONITORING_HOST")
    }
  }

  // 60 s, as everywhere else: free-tier series are priced at one data point per minute.
  prometheus.scrape "db" {
    targets         = discovery.relabel.db.output
    job_name        = "integrations/db-o11y"
    scrape_interval = "60s"
    forward_to      = [argument.metrics_receiver.value]
  }
}

booking_postgres "staging" {
  instance         = "booking-staging"
  db_host          = "booking-db-staging"
  password         = sys.env("DB_O11Y_STAGING_PASSWORD")
  metrics_receiver = prometheus.relabel.keep.receiver
  logs_receiver    = loki.write.grafana_cloud.receiver
}

booking_postgres "prod" {
  instance         = "booking-prod"
  db_host          = "booking-db-prod"
  password         = sys.env("DB_O11Y_PROD_PASSWORD")
  metrics_receiver = prometheus.relabel.keep.receiver
  logs_receiver    = loki.write.grafana_cloud.receiver
}

// The series budget. An allowlist, as in the monitoring stack: whatever the exporter adds in
// a future Alloy, only these families leave the host.
//   up                            scrape health, per target
//   database_observability_.*     the component's own metrics (connection info, errors)
//   pg_up, pg_stat_statements_.*  what Database Observability's query views read
//   pg_stat_database_* (subset)   per-database throughput, cache hits, deadlocks
//   pg_database_size_bytes        per-database size
// If a Database Observability view is empty after deploy, check here before anything else.
prometheus.relabel "keep" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    source_labels = ["__name__"]
    regex         = "up|database_observability_.+|pg_up|pg_stat_statements_.+|pg_stat_database_(numbackends|xact_commit|xact_rollback|blks_read|blks_hit|deadlocks|temp_bytes)|pg_database_size_bytes"
    action        = "keep"
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}
